<UserControl x:Class="LayerLog.App.Viewer.FigurePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="390" Background="{StaticResource Panel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/> <!-- the title bar's status and window buttons sit here -->
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="26,6,26,16">
        <TextBlock Text="{Binding FigureName}" Style="{StaticResource Title}"/>
        <TextBlock Text="{Binding Place}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" Visibility="{Binding SizeText, Converter={StaticResource NullToCollapsed}}"/>

        <TextBlock Text="Encara no l'has impresa. Quan connectis una SD amb un gcode d'aquesta figura, apareixerà aquí." Style="{StaticResource MutedText}" FontSize="14" Margin="0,22,0,0"
                   Visibility="{Binding HasAttempts, Converter={StaticResource NotBoolToVisible}}"/>

        <StackPanel Margin="0,22,0,0" Visibility="{Binding BestAttempt, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding BestStars}" Style="{StaticResource Stars}" FontSize="14" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding BestSpoken}"/>
            <TextBlock Text="El que va funcionar" Style="{StaticResource H2}"/>
          </DockPanel>
          <TextBlock Text="{Binding BestNote, StringFormat=“{0}”}" FontSize="17" LineHeight="24" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding BestNote, Converter={StaticResource NullToCollapsed}}"/>
          <TextBlock Text="{Binding BestDetail}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding BestCaution}" Style="{StaticResource MutedText}" Margin="0,8,0,0" Visibility="{Binding BestCaution, Converter={StaticResource NullToCollapsed}}"/>

          <ItemsControl ItemsSource="{Binding BestChanges}" ItemTemplate="{StaticResource ChangeItem}" Grid.IsSharedSizeScope="True" Focusable="False" Margin="0,10,0,0"/>
          <Button Style="{StaticResource LinkButton}" Content="{Binding AllChangesText}" HorizontalAlignment="Left" Margin="0,8,0,0"
                  Command="{Binding SelectAttemptCommand}" CommandParameter="{Binding BestAttempt}"/>
        </StackPanel>

        <StackPanel Margin="0,22,0,0" Visibility="{Binding AttemptsTitle, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding AttemptsTitle}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <ItemsControl ItemsSource="{Binding Attempts}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Raised}" BorderThickness="0,1,0,0">
                  <Button Style="{StaticResource RowButton}" Padding="6,8" Margin="-6,2" AutomationProperties.Name="{Binding Name}"
                          Command="{Binding DataContext.SelectAttemptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Margin="12,0,0,0" AutomationProperties.Name="{Binding Spoken}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsRated}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Change}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="Enviar a Creality Print" Padding="16,13" Margin="26,10,26,22" Command="{Binding SendCommand}"/>
  </Grid>
</UserControl>
