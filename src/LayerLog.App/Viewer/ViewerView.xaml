<UserControl x:Class="LayerLog.App.Viewer.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:viewer="clr-namespace:LayerLog.App.Viewer">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <hx:Viewport3DX x:Name="View" BackgroundColor="#233D47" ShowCoordinateSystem="False" ShowViewCube="False" EnableSwapChainRendering="False"
                    FXAALevel="Low" IsTabStop="False" CameraRotationMode="Turntable" ZoomExtentsWhenLoaded="False" IsChangeFieldOfViewEnabled="False"
                    AutomationProperties.Name="Vista 3D de la figura">
      <hx:Viewport3DX.InputBindings>
        <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="LeftClick"/>
        <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="RightClick"/>
        <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="MiddleClick"/>
      </hx:Viewport3DX.InputBindings>
      <hx:AmbientLight3D Color="#6A6A6A"/>
      <hx:DirectionalLight3D Color="#5A5854" Direction="-0.25,-1,-0.35"/>
      <hx:DirectionalLight3D Color="#3C3C40" Direction="{Binding Camera.LookDirection, ElementName=View}"/>
      <hx:ScreenQuadModel3D x:Name="Sweep"/>
      <hx:MeshGeometryModel3D x:Name="ContactShadow" IsTransparent="True"/>
      <hx:MeshGeometryModel3D x:Name="Mesh" CullMode="Back"/>
    </hx:Viewport3DX>

    <!-- Opaque, because the sweep is too light behind Muted text at its centre -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Padding="14,10" CornerRadius="8" IsHitTestVisible="{Binding ShowOrphan}"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding SceneMessage}" Value="{x:Null}"/>
                <Condition Binding="{Binding ShowLoading}" Value="False"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <TextBlock Text="{Binding SceneMessage}" Style="{StaticResource MutedText}" TextAlignment="Center" FontSize="14"
                   Visibility="{Binding SceneMessage, Converter={StaticResource NullToCollapsed}}"/>
        <StackPanel Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisible}}">
          <TextBlock Text="Carregant el model" Style="{StaticResource MutedText}" TextAlignment="Center"/>
          <ProgressBar IsIndeterminate="True" Height="3" Width="180" Margin="0,10,0,0" Foreground="{StaticResource Ink}" Background="{StaticResource Line}" BorderThickness="0"/>
        </StackPanel>
        <Grid Visibility="{Binding ShowOrphan, Converter={StaticResource BoolToVisible}}">
          <Button Style="{StaticResource PrimaryButton}" Content="Assignar model" HorizontalAlignment="Center" Margin="0,12,0,2" Command="{Binding Attempt.AssignFirstCommand}"
                  Visibility="{Binding Attempt.CanAssign, Converter={StaticResource BoolToVisible}}"/>
        </Grid>
      </StackPanel>
    </Border>

    <viewer:ComparisonView DataContext="{Binding Attempt}" Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisible}}"/>

    <!-- Auto column: with neither a figure nor an attempt the panel goes and the scene takes the whole width -->
    <viewer:FigurePanel Grid.Column="1" Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVisible}}"/>
    <viewer:AttemptPanel x:Name="AttemptPanel" Grid.Column="1" DataContext="{Binding Attempt}"
                         Visibility="{Binding DataContext.SelectedAttempt, RelativeSource={RelativeSource AncestorType=viewer:ViewerView}, Converter={StaticResource NullToCollapsed}}"/>
  </Grid>
</UserControl>
