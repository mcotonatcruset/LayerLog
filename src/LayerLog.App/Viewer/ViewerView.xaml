<UserControl x:Class="LayerLog.App.Viewer.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:viewer="clr-namespace:LayerLog.App.Viewer"
             xmlns:models="clr-namespace:LayerLog.Core.Models;assembly=LayerLog.Core">
  <UserControl.Resources>
    <!-- The file type shows until the picture is ready, and stays for 3MF and unreadable files -->
    <DataTemplate x:Key="FigureThumb" DataType="viewer:ExplorerNode">
      <Grid Width="40" Height="40">
        <Border Background="{StaticResource Surface2}" CornerRadius="4" Opacity="0.6"/>
        <TextBlock Text="{Binding Extension}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Image Source="{Binding Thumbnail}" RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}"/>
      </Grid>
    </DataTemplate>

    <Style x:Key="FilterButton" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Command" Value="{Binding SetFilterCommand}"/>
    </Style>

    <Style x:Key="ExplorerItem" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border x:Name="Row" CornerRadius="5" Padding="6,4" Background="Transparent">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand"
                                Foreground="{StaticResource Muted}" Style="{StaticResource LinkButton}" VerticalAlignment="Center">
                    <TextBlock x:Name="Glyph" Text="▸" FontSize="11"/>
                  </ToggleButton>
                  <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                </Grid>
              </Border>
              <ItemsPresenter x:Name="Kids" Margin="14,0,0,0"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="Kids" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Glyph" Property="Text" Value="▾"/>
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
              </Trigger>
              <Trigger Property="IsMouseOver" SourceName="Row" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <hx:Viewport3DX x:Name="View" BackgroundColor="#17181B" ShowCoordinateSystem="False" ShowViewCube="False" EnableSwapChainRendering="False"
                    FXAALevel="Low" CameraRotationMode="Turntable" ZoomExtentsWhenLoaded="False" IsChangeFieldOfViewEnabled="False"
                    AutomationProperties.Name="Vista 3D de la figura">
      <hx:Viewport3DX.InputBindings>
        <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="LeftClick"/>
        <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="RightClick"/>
        <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="MiddleClick"/>
      </hx:Viewport3DX.InputBindings>
      <hx:AmbientLight3D Color="#6A6A6A"/>
      <hx:DirectionalLight3D Color="#5A5854" Direction="-0.25,-1,-0.35"/>
      <hx:DirectionalLight3D Color="#3C3C40" Direction="{Binding Camera.LookDirection, ElementName=View}"/>
      <hx:MeshGeometryModel3D x:Name="Floor"/>
      <hx:MeshGeometryModel3D x:Name="Mesh" CullMode="Back"/>
    </hx:Viewport3DX>

    <!-- Soft fades keep the side text readable when a zoomed model passes behind it -->
    <Rectangle HorizontalAlignment="Left" Width="420" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#C017181B" Offset="0"/>
          <GradientStop Color="#9017181B" Offset="0.7"/>
          <GradientStop Color="#0017181B" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle HorizontalAlignment="Right" Width="420" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
          <GradientStop Color="#C017181B" Offset="0"/>
          <GradientStop Color="#9017181B" Offset="0.7"/>
          <GradientStop Color="#0017181B" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" IsHitTestVisible="False" Effect="{StaticResource SceneShadow}">
      <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" TextAlignment="Center" FontSize="14"
                 Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
      <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}">
        <TextBlock Text="Carregant el model" Style="{StaticResource MutedText}" TextAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Height="3" Width="180" Margin="0,10,0,0" Foreground="{StaticResource Ivory}" Background="{StaticResource Line}" BorderThickness="0"/>
      </StackPanel>
    </StackPanel>

    <!-- Explorer: text on the scene itself, with no container behind it -->
    <DockPanel HorizontalAlignment="Left" Width="320" Margin="12,56,0,20">
      <DockPanel DockPanel.Dock="Top" Margin="8,0,8,8" Effect="{StaticResource SceneShadow}">
        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Canviar" Command="{Binding ChangeFolderCommand}" AutomationProperties.Name="Canviar la carpeta de models"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Plegar" Command="{Binding CollapseAllCommand}" Margin="0,0,10,0" AutomationProperties.Name="Plegar totes les carpetes" ToolTip="Plegar totes les carpetes"/>
        <TextBlock Text="{Binding FolderText}" ToolTip="{Binding FolderText}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
      </DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="8,0,8,10">
        <Grid>
          <TextBox x:Name="Search" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cercar figures">
            <TextBox.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding ClearQueryCommand}"/>
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Text="Cercar figures" Foreground="{StaticResource Muted}" Margin="11,6,0,0" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Effect="{StaticResource SceneShadow}">
          <RadioButton Style="{StaticResource FilterButton}" GroupName="Filter" Content="Totes" IsChecked="True" CommandParameter="{x:Static models:FigureFilter.All}"/>
          <RadioButton Style="{StaticResource FilterButton}" GroupName="Filter" Content="Impreses" CommandParameter="{x:Static models:FigureFilter.Printed}"/>
          <RadioButton Style="{StaticResource FilterButton}" GroupName="Filter" Content="Sense imprimir" CommandParameter="{x:Static models:FigureFilter.Unprinted}"/>
        </StackPanel>
      </StackPanel>

      <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Effect="{StaticResource SceneShadow}" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisible}}">
        <StackPanel>
          <TextBlock Text="Cap figura coincideix amb la cerca." Style="{StaticResource MutedText}" Margin="8,4" Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisible}}"/>
          <ItemsControl ItemsSource="{Binding Results}" AutomationProperties.Name="Resultats">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="viewer:ExplorerNode">
                <Border CornerRadius="5">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="Background" Value="{StaticResource Selected}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Name}">
                    <DockPanel>
                      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FigureThumb}" Margin="0,0,10,0"/>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding GcodeCount}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding HasCount, Converter={StaticResource BoolToVisible}}" ToolTip="Gcode d'aquesta figura"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" Background="Transparent" Visibility="{Binding ShowResults, Converter={StaticResource NotBoolToVisible}}" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ExplorerItem}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" Effect="{StaticResource SceneShadow}"
                SelectedItemChanged="OnTreeSelection" AutomationProperties.Name="Models">
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate DataType="viewer:ExplorerNode" ItemsSource="{Binding Children}">
            <DockPanel>
              <CheckBox x:Name="Mark" IsChecked="{Binding IsMarked}" Margin="0,0,6,0" Opacity="0" Visibility="Collapsed" AutomationProperties.Name="{Binding Name, StringFormat='Seleccionar {0}'}"/>
              <ContentPresenter x:Name="Thumb" Content="{Binding}" ContentTemplate="{StaticResource FigureThumb}" Margin="0,0,8,0" Visibility="Collapsed"/>
              <TextBlock x:Name="Count" VerticalAlignment="Center" DockPanel.Dock="Right" Text="{Binding GcodeCount}" Style="{StaticResource MutedText}" Margin="8,0,0,0" Visibility="Collapsed"
                         ToolTip="Gcode d'aquesta figura"/>
              <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"/>
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsFile}" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                <Setter TargetName="Mark" Property="Opacity" Value="1"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsMarked}" Value="True">
                <Setter TargetName="Mark" Property="Opacity" Value="1"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Mark}" Value="True">
                <Setter TargetName="Mark" Property="Opacity" Value="1"/>
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsFile}" Value="True"/>
                  <Condition Binding="{Binding HasCount}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Count" Property="Visibility" Value="Visible"/>
              </MultiDataTrigger>
            </HierarchicalDataTemplate.Triggers>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      </Grid>
    </DockPanel>

    <!-- Figure label -->
    <ScrollViewer HorizontalAlignment="Right" Width="330" Margin="0,64,16,84" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding FigureName, Converter={StaticResource NullToCollapsed}}">
      <StackPanel Margin="4,0" Effect="{StaticResource SceneShadow}">
        <TextBlock Text="{Binding FigureName}" Style="{StaticResource H1}"/>
        <TextBlock Text="{Binding FileName}" Style="{StaticResource MutedText}"/>
        <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" Visibility="{Binding SizeText, Converter={StaticResource NullToCollapsed}}"/>

        <TextBlock Text="Encara no l'has impresa. Quan connectis una SD amb un gcode d'aquesta figura, apareixerà aquí." Style="{StaticResource MutedText}" FontSize="14" Margin="0,22,0,0"
                   Visibility="{Binding HasPrints, Converter={StaticResource NotBoolToVisible}}"/>

        <StackPanel Margin="0,22,0,0" Visibility="{Binding BestProfile, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="Millor configuració" Style="{StaticResource H2}"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding BestProfile}" Style="{StaticResource MutedText}"/>
            <TextBlock Text=" · " Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding BestStars}" Style="{StaticResource Stars}" AutomationProperties.Name="{Binding BestSpoken}"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding BestRows}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,1">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Margin="0,22,0,0" Visibility="{Binding HasPrints, Converter={StaticResource BoolToVisible}}">
          <TextBlock Text="Intents" Style="{StaticResource H2}" Margin="0,0,0,6"/>
          <ItemsControl ItemsSource="{Binding Prints}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource RowButton}" Margin="-6,0" Command="{Binding DataContext.OpenPrintCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                  <DockPanel>
                    <Image Source="{Binding Thumbnail}" Width="44" Height="44" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding FileName}"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20">
      <TextBlock Style="{StaticResource MutedText}" TextAlignment="Right" MaxWidth="320" Margin="0,0,0,6" Effect="{StaticResource SceneShadow}"
                 Visibility="{Binding ShowGroupHint, Converter={StaticResource BoolToVisible}}">
        Creality Print preguntarà si les vols carregar com un sol objecte. Respon <Bold>No</Bold>.
      </TextBlock>
      <Button Style="{StaticResource PrimaryButton}" Content="{Binding SendText}" Command="{Binding SendCommand}" HorizontalAlignment="Right"/>
    </StackPanel>
  </Grid>
</UserControl>
