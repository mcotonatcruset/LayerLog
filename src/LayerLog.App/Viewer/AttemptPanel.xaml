<UserControl x:Class="LayerLog.App.Viewer.AttemptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="390" Background="{StaticResource Panel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/> <!-- the title bar's status and window buttons sit here -->
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>

    <Button x:Name="BackButton" Grid.Row="1" Style="{StaticResource LinkButton}" Content="← Tornar" FontSize="14" HorizontalAlignment="Left" Margin="26,0,0,12"
            Command="{Binding CloseCommand}" AutomationProperties.Name="Tornar" ToolTip="Tornar (Esc)"/>

    <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="26,0,26,24">
        <DockPanel>
          <Image Source="{Binding Thumbnail}" Width="64" Height="64" Margin="0,0,14,0" VerticalAlignment="Top" Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}"/>
          <TextBlock Text="{Binding FileName}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding NoteMeta}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>

        <Grid Margin="0,14,0,0" HorizontalAlignment="Left">
          <ToggleButton x:Name="CompareButton" Style="{StaticResource FlatButton}" Content="Comparar amb…" Padding="12,5" IsChecked="{Binding IsChoosing}"
                        AutomationProperties.Name="Comparar amb un altre gcode" ToolTip="Comparar amb un altre gcode"/>
          <Popup IsOpen="{Binding IsChoosing}" PlacementTarget="{Binding ElementName=CompareButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False"
                 Opened="OnChoicesOpened">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,4,8,8" Width="340">
              <ListBox x:Name="Choices" ItemsSource="{Binding CompareChoices}" MaxHeight="360" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" Padding="4"
                       AutomationProperties.Name="Gcode per comparar" PreviewKeyDown="OnChoicesKey">
                <ListBox.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" Margin="8,10,8,4"/>
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnChoiceClicked"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="8,6">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Raised}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Popup>
        </Grid>

        <StackPanel Margin="0,22,0,0" Visibility="{Binding FiguresTitle, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding FiguresTitle}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
          <ItemsControl ItemsSource="{Binding Figures}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,3">
                  <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Obrir la figura" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding OpenCommand}"
                          AutomationProperties.Name="{Binding Name, StringFormat='Obrir la figura de {0}'}" Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisible}}"/>
                  <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Assignar model" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding AssignCommand}"
                          AutomationProperties.Name="{Binding Name, StringFormat='Assignar model a {0}'}" Visibility="{Binding IsLinked, Converter={StaticResource NotBoolToVisible}}"/>
                  <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Margin="0,22,0,0" Grid.IsSharedSizeScope="True">
          <TextBlock Text="{Binding ChangesTitle}" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding Caution}" Style="{StaticResource MutedText}" Margin="0,6,0,0" Visibility="{Binding Caution, Converter={StaticResource NullToCollapsed}}"/>
          <ItemsControl ItemsSource="{Binding Changes}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                  <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Base"/>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Used" MinWidth="74"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Paràmetre" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="1" Text="Base" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Usat" Style="{StaticResource MutedText}" Margin="12,0,0,0" TextAlignment="Right"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ChangeItem}" Focusable="False"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Margin="0,22,0,0">
          <DockPanel Margin="0,0,0,4">
            <Button x:Name="AddPrintButton" DockPanel.Dock="Right" Content="Afegir impressió" Command="{Binding AddPrintCommand}" Padding="12,5"/>
            <TextBlock Text="Impressions" Style="{StaticResource H2}" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Prints}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Raised}" BorderThickness="0,0,0,1" Padding="0,12">
                  <StackPanel>
                    <DockPanel>
                      <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Width="104" VerticalAlignment="Center" AutomationProperties.Name="Data de la impressió, dia, mes i any" AutomationProperties.HelpText="Exemple: 31/10/2026" ToolTip="Dia/mes/any">
                        <TextBox.Style>
                          <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DateInvalid}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding RatingText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                      <ItemsControl ItemsSource="{Binding Choices}" VerticalAlignment="Center" Margin="14,0,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Style="{StaticResource StarButton}" Content="{Binding Glyph}" AutomationProperties.Name="{Binding Spoken}"
                                    Command="{Binding DataContext.RateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>
                    <TextBlock Text="Data no vàlida" Foreground="{StaticResource Ink}" FontSize="13" Margin="0,4,0,0" Visibility="{Binding DateInvalid, Converter={StaticResource BoolToVisible}}"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,8,0,0" AutomationProperties.Name="Nota de la impressió"/>
                    <Image Source="{Binding Photo}" MaxHeight="240" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Photo, Converter={StaticResource NullToCollapsed}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsConfirmingDelete, Converter={StaticResource NotBoolToVisible}}">
                      <Button Style="{StaticResource LinkButton}" Content="Afegir foto" Command="{Binding AddPhotoCommand}"/>
                      <Button x:Name="AskDelete" Style="{StaticResource LinkButton}" Content="Esborrar" Command="{Binding AskDeleteCommand}" Margin="16,0,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Tag="{Binding ElementName=AskDelete}" IsVisibleChanged="OnConfirmShown"
                                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisible}}">
                      <StackPanel.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding CancelDeleteCommand}"/>
                      </StackPanel.InputBindings>
                      <TextBlock Text="{Binding DeleteWarning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Cancel·lar" Command="{Binding CancelDeleteCommand}" Padding="12,5"/>
                        <Button Content="Esborrar" Command="{Binding DeleteCommand}" Click="OnDeleted" Padding="12,5" Margin="8,0,0,0" AutomationProperties.Name="Esborrar la impressió"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Sense imprimir" Style="{StaticResource MutedText}" Margin="0,4,0,0" Visibility="{Binding HasPrints, Converter={StaticResource NotBoolToVisible}}"/>
        </StackPanel>

        <StackPanel Margin="0,22,0,0">
          <ToggleButton Style="{StaticResource LinkButton}" Foreground="{StaticResource Muted}" FontSize="14" Content="{Binding FullConfigTitle}" IsChecked="{Binding ShowFullConfig}" HorizontalAlignment="Left"/>
          <TextBox Text="{Binding FullConfig, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Muted}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0"
                   AutomationProperties.Name="Configuració completa" Visibility="{Binding ShowFullConfig, Converter={StaticResource BoolToVisible}}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
