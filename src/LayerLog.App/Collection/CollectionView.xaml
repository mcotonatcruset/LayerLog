<UserControl x:Class="LayerLog.App.Collection.CollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:collection="clr-namespace:LayerLog.App.Collection">
  <UserControl.Resources>
    <ContextMenu x:Key="CardMenu">
      <MenuItem Header="Obrir" Click="OnMenuOpen"/>
      <MenuItem Header="Canviar el nom" InputGestureText="F2" Click="OnMenuRename"/>
      <MenuItem Header="{Binding PartLabel}" Click="OnMenuPart"/>
      <MenuItem Header="Seleccionar per enviar" InputGestureText="Espai" IsCheckable="True" IsChecked="{Binding IsMarked}"/>
    </ContextMenu>

    <Style x:Key="CardFocus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-5" Stroke="{StaticResource Ink}" StrokeThickness="2" RadiusX="14" RadiusY="14" IsHitTestVisible="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Selecting is only ListBox bookkeeping here: what shows is FigureCard.IsSelected, the figure that's open -->
    <Style x:Key="CardItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocus}"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
      <Setter Property="ContextMenu" Value="{StaticResource CardMenu}"/>
      <EventSetter Event="MouseLeftButtonUp" Handler="OnCardClick"/>
      <EventSetter Event="KeyDown" Handler="OnCardKey"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <ContentPresenter/>
              <Border x:Name="Over" CornerRadius="10" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Over" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One ListBox per row of cards. No ScrollViewer inside, so the wheel reaches the list around them -->
    <Style x:Key="CardList" TargetType="ListBox">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,0,-16,16"/>
      <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource CardItem}"/>
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ItemsPresenter/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MarkBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="10"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsChecked" Value="{Binding IsMarked}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Figure.Name, StringFormat='Seleccionar {0}'}"/>
      <Setter Property="ToolTip" Value="Seleccionar per enviar (Espai)"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMarked}" Value="True">
          <Setter Property="Opacity" Value="1"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Opacity" Value="1"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Opacity" Value="1"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CardFace" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Margin" Value="-2"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Muted}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The file type shows until the picture is ready, and stays for 3MF and unreadable files -->
    <DataTemplate x:Key="Picture" DataType="collection:FigureCard">
      <Grid>
        <TextBlock x:Name="Extension" Text="{Binding Extension}" Foreground="{StaticResource Soft}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image Source="{Binding Thumbnail}" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}" Value="Visible">
          <Setter TargetName="Extension" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="CardName" DataType="collection:FigureCard">
      <Grid>
        <TextBlock Text="{Binding Figure.Name}" ToolTip="{Binding Figure.RelativePath}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding IsRenaming, Converter={StaticResource NotBoolToVisible}}"/>
        <TextBox Text="{Binding Figure.Name, Mode=OneWay}" AutomationProperties.Name="Nom de la figura" Padding="4,2" Cursor="IBeam"
                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisible}}"
                 IsVisibleChanged="OnNameShown" PreviewKeyDown="OnNameKey" LostKeyboardFocus="OnNameLeft"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="HeroCard" DataType="collection:FigureCard">
      <Grid>
        <Border Style="{StaticResource CardFace}" Background="{StaticResource CardGlow}">
          <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Picture}" Height="{x:Static collection:FigureCard.HeroSize}" Margin="0,0,0,10"/>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding RatingStars}" Style="{StaticResource Stars}" Margin="8,3,0,0" Visibility="{Binding RatingStars, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock DockPanel.Dock="Right" Text="{Binding RatingNote}" Foreground="{StaticResource Soft}" FontSize="13" Margin="8,2,0,0" Visibility="{Binding RatingNote, Converter={StaticResource NullToCollapsed}}"/>
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardName}" TextElement.FontSize="16" MaxHeight="48"/>
            </DockPanel>
            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Soft}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
          </StackPanel>
        </Border>
        <CheckBox Style="{StaticResource MarkBox}"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CompactCard" DataType="collection:FigureCard">
      <Grid>
        <Border Style="{StaticResource CardFace}" Background="{StaticResource Card}">
          <DockPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Picture}" Width="{x:Static collection:FigureCard.CompactSize}" Height="{x:Static collection:FigureCard.CompactSize}" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardName}" MaxHeight="58"/>
              <TextBlock Text="{Binding RatingStars}" Style="{StaticResource Stars}" Margin="0,2,0,0" Visibility="{Binding RatingStars, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding RatingNote}" Foreground="{StaticResource Soft}" FontSize="13" Margin="0,2,0,0" Visibility="{Binding RatingNote, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Soft}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <CheckBox Style="{StaticResource MarkBox}"/>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type collection:HeroRow}">
      <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource HeroCard}" AutomationProperties.Name="Recents"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type collection:CardRow}">
      <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CompactCard}" AutomationProperties.Name="Figures"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type collection:HeaderRow}">
      <DockPanel Margin="0,6,0,8">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type collection:SectionRow}">
      <DockPanel Margin="-4,6,0,8">
        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding Section.PartsText}" IsChecked="{Binding Section.ShowParts}" VerticalAlignment="Center"
                      Visibility="{Binding Section.HasParts, Converter={StaticResource BoolToVisible}}"/>
        <ToggleButton x:Name="Toggle" Style="{StaticResource FlatButton}" Background="Transparent" Padding="4,2" HorizontalAlignment="Left" IsChecked="{Binding Section.IsExpanded}"
                      AutomationProperties.Name="{Binding Section.Title}">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Glyph" Text="▸" Width="16" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="{Binding Section.Title}" Style="{StaticResource H2}"/>
          </StackPanel>
        </ToggleButton>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Section.IsExpanded}" Value="True">
          <Setter TargetName="Glyph" Property="Text" Value="▾"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type collection:EntryRow}">
      <DockPanel Width="560" HorizontalAlignment="Left" Margin="0,0,0,6">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Date}" Style="{StaticResource MutedText}" Margin="24,0,0,0"/>
        <TextBlock Text="{Binding Entry.FileName}" ToolTip="{Binding Entry.FileName}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="28,0,28,6">
      <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Canviar" Command="{Binding ChangeFolderCommand}" AutomationProperties.Name="Canviar la carpeta de models"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Plegar" Command="{Binding CollapseAllCommand}" Margin="0,0,14,0" AutomationProperties.Name="Plegar totes les carpetes" ToolTip="Plegar totes les carpetes"/>
      <TextBlock Text="{Binding FolderText}" ToolTip="{Binding FolderText}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
    </DockPanel>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="28,12" Visibility="{Binding MarkedText, Converter={StaticResource NullToCollapsed}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding SendText}" Command="{Binding SendCommand}"/>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   Visibility="{Binding ShowGroupHint, Converter={StaticResource BoolToVisible}}">
          Creality Print preguntarà si les vols carregar com un sol objecte. Respon <Bold>No</Bold>.
        </TextBlock>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding MarkedText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" Margin="0,0,14,0"/>
          <Button Style="{StaticResource LinkButton}" Content="Treure la selecció" Command="{Binding ClearMarksCommand}" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <!-- ponytail: a virtualized list of rows, not a wrap panel; arrow keys only reach rows WPF has realized (one page around the view) -->
      <ItemsControl x:Name="List" ItemsSource="{Binding Rows}" Focusable="False" SizeChanged="OnListResized"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page">
        <!-- The side margin is inside the scroll area, so the scroll viewport doesn't clip a focus ring -->
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Margin" Value="6,0"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Template>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" Padding="22,4,14,16">
              <ItemsPresenter/>
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
      </ItemsControl>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="14" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        <Button Style="{StaticResource PrimaryButton}" Content="Triar una carpeta" Command="{Binding ChangeFolderCommand}" Margin="0,14,0,0" HorizontalAlignment="Center"
                Visibility="{Binding NeedsFolder, Converter={StaticResource BoolToVisible}}"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
