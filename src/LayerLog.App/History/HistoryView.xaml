<UserControl x:Class="LayerLog.App.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="EntryItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="6" Padding="8" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource Selected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Rule" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="0,4"/>
    </Style>
    <Style x:Key="MoreToggle" TargetType="ToggleButton" BasedOn="{StaticResource LinkButton}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBox">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="MaxHeight" Value="260"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="430"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- List -->
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,10">
          <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cerca per fitxer o figura"/>
          <TextBlock Text="Cerca per fitxer o figura" Foreground="{StaticResource Faint}" Margin="10,6,0,0" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Comparar" Command="{Binding CompareCommand}" Padding="14,6"/>
            <TextBlock Text="{Binding CompareText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" Margin="8,0" ItemContainerStyle="{StaticResource EntryItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Gcode importats">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <CheckBox IsChecked="{Binding IsMarked}" Margin="0,0,10,0" AutomationProperties.Name="{Binding Entry.FileName, StringFormat='Comparar {0}'}"/>
                <Image Source="{Binding Thumbnail}" Width="48" Height="48" Margin="0,0,10,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Entry.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Empty -->
    <StackPanel Grid.Column="1" MaxWidth="380" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
      <TextBlock Text="Encara no hi ha res aquí" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
      <TextBlock Text="Connecta una targeta SD. LayerLog llegirà els gcode i guardarà la configuració de cada un, sense modificar res de la targeta." Style="{StaticResource MutedText}" FontSize="14" TextAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>

    <!-- Note -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowNote, Converter={StaticResource BoolToVisible}}">
      <StackPanel MaxWidth="720" Margin="40,28,40,48">
        <DockPanel>
          <Image Source="{Binding Selected.Thumbnail}" Width="96" Height="96" Margin="0,0,18,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Selected.Entry.FileName}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding NoteMeta}" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </DockPanel>

        <StackPanel Margin="0,26,0,0">
          <TextBlock Text="Figures" Style="{StaticResource H2}" Margin="0,0,0,4"/>
          <ItemsControl ItemsSource="{Binding Figures}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <TextBlock Text="{Binding Name}"/>
                  <Button Style="{StaticResource LinkButton}" Content="Veure al visor" Margin="12,0,0,0" Command="{Binding OpenCommand}"
                          Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisible}}"/>
                  <Button Style="{StaticResource LinkButton}" Content="Assignar model" Margin="12,0,0,0" Command="{Binding AssignCommand}"
                          Visibility="{Binding IsLinked, Converter={StaticResource NotBoolToVisible}}"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Margin="0,26,0,0">
          <TextBlock Text="{Binding ChangesTitle}" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding Caution}" Style="{StaticResource MutedText}" Visibility="{Binding Caution, Converter={StaticResource NullToCollapsed}}"/>
          <TextBlock Text="No s'ha trobat algun perfil base: mira la configuració completa." Style="{StaticResource MutedText}"
                     Visibility="{Binding BaseMissing, Converter={StaticResource BoolToVisible}}"/>
          <ItemsControl ItemsSource="{Binding Changes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Usat" Style="{StaticResource MutedText}" Width="110" TextAlignment="Right"/>
                    <TextBlock DockPanel.Dock="Right" Text="Perfil base" Style="{StaticResource MutedText}" Width="110" TextAlignment="Right"/>
                    <TextBlock Text="Paràmetre" Style="{StaticResource MutedText}"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Rule}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Width="110" TextAlignment="Right"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Base}" Foreground="{StaticResource Muted}" Width="110" TextAlignment="Right"/>
                            <TextBlock Text="{Binding Label}"/>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Margin="0,26,0,0">
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Afegir impressió" Command="{Binding AddPrintCommand}" Padding="12,5" HorizontalAlignment="Right"/>
            <TextBlock Text="Impressions" Style="{StaticResource H2}" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Prints}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Surface2}" BorderThickness="0,0,0,1" Padding="0,10">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Esborrar" Command="{Binding DeleteCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                      <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Afegir foto" Command="{Binding AddPhotoCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                      <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Width="104" VerticalAlignment="Center" AutomationProperties.Name="Data de la impressió, dia, mes i any" AutomationProperties.HelpText="Exemple: 31/10/2026" ToolTip="Dia/mes/any">
                        <TextBox.Style>
                          <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DateInvalid}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryText}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                      <TextBlock DockPanel.Dock="Left" Text="Data no vàlida" Foreground="{StaticResource PrimaryText}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding DateInvalid, Converter={StaticResource BoolToVisible}}"/>
                      <ItemsControl ItemsSource="{Binding Choices}" VerticalAlignment="Center" Margin="16,0,8,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding Glyph}" Foreground="{StaticResource Ivory}" FontSize="16" Margin="0,0,2,0"
                                    AutomationProperties.Name="{Binding Spoken}"
                                    Command="{Binding DataContext.RateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding RatingText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,8,0,0" AutomationProperties.Name="Nota de la impressió"/>
                    <Image Source="{Binding Photo}" MaxHeight="240" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Photo, Converter={StaticResource NullToCollapsed}}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Margin="0,26,0,0">
          <ToggleButton x:Name="FullToggle" Style="{StaticResource MoreToggle}" Content="{Binding FullConfigTitle}" IsChecked="{Binding BaseMissing, Mode=OneWay}" HorizontalAlignment="Left"/>
          <TextBox Style="{StaticResource Mono}" Text="{Binding FullConfig, Mode=OneWay}" Visibility="{Binding IsChecked, ElementName=FullToggle, Converter={StaticResource BoolToVisible}}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Compare -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisible}}">
      <StackPanel MaxWidth="720" Margin="40,28,40,48">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Width="150">
            <Image Source="{Binding ThumbB}" Width="72" Height="72" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding NameB}" Style="{StaticResource MutedText}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Width="150">
            <Image Source="{Binding ThumbA}" Width="72" Height="72" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding NameA}" Style="{StaticResource MutedText}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Text="Comparació" Style="{StaticResource H1}" VerticalAlignment="Bottom"/>
        </DockPanel>
        <TextBlock Text="{Binding CompareTitle}" Style="{StaticResource H2}" Margin="0,22,0,6"/>
        <ItemsControl ItemsSource="{Binding CompareRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Rule}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding B}" FontWeight="SemiBold" Width="150" TextAlignment="Right"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding A}" FontWeight="SemiBold" Width="150" TextAlignment="Right"/>
                  <TextBlock Text="{Binding Label}"/>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Margin="0,14,0,0" Visibility="{Binding CompareRestTitle, Converter={StaticResource NullToCollapsed}}">
          <ToggleButton x:Name="RestToggle" Style="{StaticResource MoreToggle}" Content="{Binding CompareRestTitle}" HorizontalAlignment="Left"/>
          <TextBox Style="{StaticResource Mono}" Text="{Binding CompareRest, Mode=OneWay}" Visibility="{Binding IsChecked, ElementName=RestToggle, Converter={StaticResource BoolToVisible}}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
