<Window x:Class="LayerLog.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:LayerLog.App.Viewer"
        xmlns:history="clr-namespace:LayerLog.App.History"
        Title="LayerLog" Width="1500" Height="900" MinWidth="1100" MinHeight="700"
        Background="{StaticResource Sweep}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="14" TextOptions.TextFormattingMode="Ideal">
  <Grid>
    <viewer:ViewerView DataContext="{Binding Viewer}"
                       Visibility="{Binding DataContext.ShowViewer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisible}}"/>
    <history:HistoryView DataContext="{Binding History}" Margin="0,48,0,0"
                         Visibility="{Binding DataContext.ShowViewer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotBoolToVisible}}"/>

    <DockPanel VerticalAlignment="Top" Height="48" Margin="20,0" LastChildFill="False" Effect="{StaticResource SceneShadow}">
      <TextBlock Text="LayerLog" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
      <RadioButton Style="{StaticResource TabButton}" Content="Visor" IsChecked="{Binding ShowViewer}" GroupName="Tabs" VerticalAlignment="Center"/>
      <RadioButton Style="{StaticResource TabButton}" Content="Historial" GroupName="Tabs" VerticalAlignment="Center" Margin="4,0,0,0"
                   IsChecked="{Binding ShowHistory}"/>
      <TextBlock DockPanel.Dock="Right" Text="{Binding CardStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
    </DockPanel>

    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Padding="14,10" CornerRadius="8"
            Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Toast}" AutomationProperties.LiveSetting="Polite"/>
        <Button Style="{StaticResource LinkButton}" Content="Veure a l'historial" Margin="16,0,0,0" Command="{Binding ShowHistoryNowCommand}"
                Visibility="{Binding ToastHasAction, Converter={StaticResource BoolToVisible}}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
